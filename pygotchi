        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_e:
                eating = 3.0
                hunger = 0

    if eating > 1:
	eating -= tick
   	current_state = 'eat%d' % (3 - int(eating))
    elif hunger > 150:
        current_state = 'sad'
    else:
        current_state = 'content'
